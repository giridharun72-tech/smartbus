# Environment variables example for SmartBus. Replace placeholders locally; never commit real secrets.
DB_USERNAME=root
DB_PASSWORD=replace_with_your_mysql_password
PORT=8080
SMARTBUS_GPS_API_KEY=replace_with_a_unique_random_key
# Generate a unique, stable secret of at least 32 characters; do not commit the value.
SMARTBUS_AADHAAR_HMAC_KEY=
